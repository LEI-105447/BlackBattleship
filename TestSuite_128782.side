  "url": "https://papergames.io",
  "tests": [
    {
      "id": "d4747f3c-6405-4bb8-8300-e03f135c2e62",
      "name": "UserStoryTest1",
      "commands": [
        {
          "id": "ada56da6-aff8-45a1-91a8-29cdf076142f",
          "comment": "Abrir a página do jogo Battleship",
          "command": "open",
          "target": "/en/battleship",
          "targets": [],
          "value": ""
        },
        {
          "id": "58ae70de-c0f7-4f92-a7dc-f08e21f5d53e",
          "comment": "Definir o tamanho da janela do navegador",
          "command": "setWindowSize",
          "target": "1550x926",
          "targets": [],
          "value": ""
        },
        {
          "id": "09304195-15dc-4f7e-864d-52e0944e91fa",
          "comment": "Esperar que os rankings carreguem",
          "command": "waitForElementPresent",
          "target": "css=app-tournament-leaderboard tr.item .player-name",
          "targets": [
            [
              "css=app-tournament-leaderboard tr.item .player-name",
              "css:finder"
            ]
          ],
          "value": "10000"
        },
        {
          "id": "037d4a40-0c73-479b-92e8-1bae6e82817c",
          "comment": "Verificar que o ranking diário é apresentado",
          "command": "assertText",
          "target": "xpath=//span[contains(.,'Daily leaderboard')]",
          "targets": [
            [
              "css=.d-flex > .c-gray-600",
              "css:finder"
            ],
            [
              "xpath=//div[2]/span",
              "xpath:position"
            ],
            [
              "xpath=//span[contains(.,'Daily leaderboard, ends in')]",
              "xpath:innerText"
            ]
          ],
          "value": "Daily leaderboard, ends in"
        },
        {
          "id": "4eff229e-64dd-4648-b3f4-3c103cdb43f4",
          "comment": "Verificar que o ranking diário lista jogadores",
          "command": "assertElementPresent",
          "target": "css=app-tournament-leaderboard tr.item .player-name",
          "targets": [
            [
              "css=.item:nth-child(1) .d-flex",
              "css:finder"
            ],
            [
              "xpath=//td[3]/div",
              "xpath:position"
            ]
          ],
          "value": ""
        },
        {
          "id": "6ab2e03d-88d3-4908-8e7a-f1c16474073d",
          "comment": "Verificar que o ranking dos últimos 30 dias é apresentado",
          "command": "assertText",
          "target": "xpath=//label[contains(.,'RANKA')]",
          "targets": [
            [
              "css=label",
              "css:finder"
            ],
            [
              "xpath=//label",
              "xpath:position"
            ],
            [
              "xpath=//label[contains(.,'RANKA')]",
              "xpath:innerText"
            ]
          ],
          "value": "RANKA"
        },
        {
          "id": "98a364d3-e091-4df9-ba02-e95eb599051c",
          "comment": "Verificar que o ranking dos últimos 30 dias lista jogadores",
          "command": "assertElementPresent",
          "target": "css=app-ranka-leaderboard tr.item .player-name",
          "targets": [
            [
              "css=.text-end:nth-child(2) .d-flex",
              "css:finder"
            ],
            [
              "xpath=//app-ranka-leaderboard/div/table/tr[2]/td[3]/div",
              "xpath:position"
            ]
          ],
          "value": ""
        }
      ]
    },
